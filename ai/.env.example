# AI Provider Configuration
# Set to 'mock' to use deterministic fallback responses without an API key
# Set to 'gemini' (or other provider) to use real AI
AI_MODE=mock

# Gemini API Key (required if AI_MODE=gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional Configurations
AI_TIMEOUT_MS=15000
AI_MAX_RETRIES=3
